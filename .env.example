# Mock mode is the default. Nothing touches a real site until you change these.
SCRAPE_MODE=mock
ADAPTER=mock
TARGET_URL=http://mock-vendor:8000
INTERVAL_SECONDS=5
HEADLESS=true
# true = add to cart once, then keep watching without grabbing again
GRAB_ONCE=true
REDIS_URL=redis://redis:6379/0
STREAM_KEY=tiketwar:events
USER_AGENT=Tiketwar-Monitor/0.1 (+personal use)
# heartbeat TTL; keep equal to the service's DEAD_AFTER_SECONDS
DEAD_AFTER_SECONDS=120
# longest pause after a block / 429 (Retry-After is honoured up to this)
MAX_BACKOFF_SECONDS=600
